# Стартовый скрипт этапа 3: команды этапов 1-3 и работа с VFS.
# Запускать с любой VFS, например:
#   python -m shellemu --vfs vfs/deep.xml --script scripts/emu/vfs_demo.emu

# --- Служебная команда: дерево загруженной VFS
vfs-tree

# --- Заглушки ls и cd (логика появится на этапе 4)
ls
ls -l /etc
cd /home/alice
cd "projects"   # аргумент в кавычках

# --- Ошибки ввода
unknown_cmd 1 2 3
ls "незакрытая кавычка
exit 1 2

# --- Завершение: exit с нечисловым аргументом завершает оболочку
# с кодом 2 (как в bash) и сообщением об ошибке
exit abc
