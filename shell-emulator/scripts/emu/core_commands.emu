# Стартовый скрипт этапа 4: ls, cd, date, tac (все режимы и ошибки).
# Запускать с вложенной VFS:
#   python -m shellemu --vfs vfs/deep.xml --script scripts/emu/core_commands.emu

# ===== ls =====
ls                       # корень
ls -l                    # длинный формат
ls -a                    # со скрытыми, . и ..
ls -la /home/alice       # объединённые опции
ls /etc /var             # несколько каталогов: заголовки
ls /etc/hostname         # файл как операнд
ls ../../etc             # путь с ..
ls /home/bob             # пустой каталог
ls /nonexistent          # ошибка: нет такого пути
ls /etc/hostname/x       # ошибка: не каталог
ls -z                    # ошибка: неизвестная опция

# ===== cd =====
cd /home/alice           # абсолютный путь
ls
cd projects/emulator     # относительный путь
ls
cd ../..                 # на два уровня вверх
cd -                     # возврат в предыдущий каталог
cd                       # без аргументов: корень
cd /etc/hostname         # ошибка: это файл
cd /nope                 # ошибка: нет каталога
cd a b                   # ошибка: слишком много аргументов
cd -z                    # ошибка: неизвестная опция

# ===== tac =====
cd /var/log
tac syslog               # строки в обратном порядке
tac /home/alice/todo.txt /etc/hostname   # несколько файлов
tac nofile               # ошибка: файла нет
tac /etc                 # ошибка: это каталог
tac                      # ошибка: нет операнда
tac -q syslog            # ошибка: неизвестная опция
tac nofile syslog        # ошибка в одном файле не мешает другим

# ===== date =====
date                     # по умолчанию
date -u                  # UTC
date -R                  # RFC 2822
date -I                  # только дата ISO
date +%Y-%m-%d           # свой формат
date "+%H:%M:%S (%A)"    # формат с пробелом
date -uR                 # объединённые опции
date вчера               # ошибка: неверная дата
date +%Y +%m             # ошибка: лишний операнд
date -z                  # ошибка: неизвестная опция

# Без exit: в окне эмулятор остаётся открытым для дальнейшей работы.
