# Стартовый скрипт эмулятора (этап 2): комментарии, заглушки, ошибки.
# Строки, начинающиеся с #, не выполняются.

ls
ls -l /home   # комментарий в конце строки тоже игнорируется
cd /etc
cd "папка с пробелами"

# Ошибки
unknown_command arg1
ls "незакрытая кавычка

# Завершение работы с кодом 0
exit
ls   # эта строка уже не выполняется
